---
import '../styles/site.css';
import {
  profile, links, skills, certifications, superbadges, education, roles, projects, solutions,
  stats, approach, capabilities, aiFlow, aiCards,
} from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = (f) => `${base}img/${f}`;
const site = 'https://innovator-repo.github.io/portfolio/bharat/';
const title = 'Bharat Kumar · Salesforce Developer';
const description =
  'Bharat Kumar, Salesforce Developer: 4 years on Experience, Sales and Service Cloud. Apex, LWC, integrations and automation for Pinterest, Assurant, CleverTap.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${links.email}`,
  url: site,
  address: { '@type': 'PostalAddress', addressLocality: 'Mathura', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
  sameAs: [links.linkedin, links.trailhead, links.github],
  knowsAbout: skills,
  hasCredential: certifications.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: `Salesforce Certified ${c.name}` })),
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Chandigarh University' },
    { '@type': 'CollegeOrUniversity', name: 'Bon Maharaj Institute of Management & Technology' },
  ],
};
const nav = [['top', 'Overview'], ['work', 'Work'], ['solutions', 'Solutions'], ['ai', 'AI'], ['approach', 'Approach'], ['experience', 'Experience'], ['credentials', 'Credentials']];
const [lead, ...rest] = projects;
const spans = ['s3', 's3', 's4', 's2'];
const [inspector, scheduler] = solutions;
---
<!doctype html>
<html lang="en" dir="ltr" data-skin="light">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.endsWith('github.io'))addEventListener('load',function(){setTimeout(function(){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NZNLNPV2')},1500)});</script>
    <script is:inline>try{var t=localStorage.getItem('skin');if(t==='dark'||t==='light')document.documentElement.dataset.skin=t}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={site} />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bharat Kumar, Salesforce Developer" />
    <meta property="og:site_name" content="Bharat Kumar" />
    <meta property="og:locale" content="en_IN" />
    <meta name="author" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}og.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NZNLNPV2" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <nav aria-label="Primary"><div class="capsule">
      <b><i class="ico i-bk" aria-hidden="true">BK</i>{profile.name}</b>
      {nav.map(([id, label], i) => <a class={i === 0 ? 'cur' : undefined} href={`#${id}`}>{label}</a>)}
      <button class="theme" type="button" aria-label="Switch between light and dark"><svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.7 14.6A8.5 8.5 0 0 1 9.4 3.3a8.5 8.5 0 1 0 11.3 11.3z"/></svg><svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg></button>
      <a class="go" href="#contact">Get in touch</a>
    </div></nav>

    <main id="main">
    <header class="hero" id="top"><div class="wrap">
      <span class="eyebrow">{profile.role}</span>
      <h1>Salesforce that holds up in production.</h1>
      <p class="lede">I build Apex, Lightning Web Components and integrations for Sales, Service and Experience Cloud, and automate the work people used to do by hand.</p>
      <div class="cta"><a class="btn" href="#work">View my work</a><a class="lnk" href={`${base}Resume.pdf`} download>Download résumé ›</a></div>

      <div class="stage" aria-label="Interactive demo of Transaction Inspector"><div class="wall" aria-hidden="true"></div><div class="app">
        <div class="bar"><strong>Transaction Inspector</strong><div class="seg" role="tablist"><span class="on" role="tab">Map</span><span role="tab">Queries</span><span role="tab">Findings</span><span role="tab">Async</span></div></div>
        <div class="cols">
          <div class="side"><div class="lab">Transactions</div>
            <div class="tx on" role="button" tabindex="0"><b class="c1">S</b>Sync save<small>412 ms</small></div>
            <div class="tx c">AccountTrigger<small>before</small></div>
            <div class="tx c">Account_Flow<small>after</small></div>
            <div class="tx" role="button" tabindex="0"><b class="c2">F</b>@future callout<small>1.2 s</small></div>
            <div class="tx" role="button" tabindex="0"><b class="c4">Q</b>SyncQueueable<small>640 ms</small></div>
            <div class="tx c">Finalizer<small>ok</small></div>
            <div class="tx" role="button" tabindex="0"><b class="c3">B</b>Batch chunk 1 of 4<small>2.1 s</small></div>
            <div class="tx" role="button" tabindex="0"><b class="c5">E</b>Platform event<small>88 ms</small></div></div>
          <div class="main" aria-live="polite"><h5>Sync save</h5><p>1 record · 2 triggers · 1 flow · 3 async jobs started</p>
            <div class="lim">
              <div><span>SOQL queries</span><strong>38 <small>of 100</small></strong><div class="pb"><s style="width:38%"></s></div></div>
              <div><span>DML statements</span><strong>18 <small>of 150</small></strong><div class="pb g"><s style="width:12%"></s></div></div>
              <div><span>CPU time</span><strong>7,940 <small>of 10,000 ms</small></strong><div class="pb o"><s style="width:79%"></s></div></div>
              <div><span>Heap size</span><strong>1.4 <small>of 6 MB</small></strong><div class="pb p"><s style="width:23%"></s></div></div>
              <div><span>Callouts</span><strong>2 <small>of 100</small></strong><div class="pb g"><s style="width:4%"></s></div></div>
              <div><span>Queueable jobs</span><strong>1 <small>of 50</small></strong><div class="pb"><s style="width:3%"></s></div></div>
            </div></div>
          <div class="find" style="position:relative"><div class="lab">Findings</div>
            <div class="f"><i style="background:#ff453a">!</i><div><b>SOQL query inside a loop</b><p><code>AccountTrigger.cls:42</code> runs once per record. Move it above the loop.</p></div></div>
            <div class="f"><i style="background:#ff9f0a">!</i><div><b>CPU time near limit</b><p>79% used in one save. Flow and trigger both recalculate rollups.</p></div></div>
            <div class="f"><i style="background:#30d158">✓</i><div><b>DML is bulkified</b><p>All 18 statements operate on collections.</p></div></div></div>
        </div><span class="hint">Click a transaction ›</span></div></div>
    </div></header>

    <div class="proof"><div class="wrap">
      <small>Delivered for teams at</small>
      <div class="names"><b>Pinterest</b><b>Assurant</b><b>CleverTap</b></div>
      <div class="widgets">
        {stats.map((s) => <div class="wg"><i class={`ico ${s.c}`} aria-hidden="true">{s.icon}</i><strong data-n={s.n} data-s={s.s}>{s.n}{s.s}</strong><span>{s.label}</span></div>)}
      </div>
    </div></div>

    <section id="work"><div class="wrap">
      <div class="hrow"><h2 class="h">Selected work. <span>Real orgs, real users, real limits.</span></h2></div>
      <div class="grid">
        <article class="tile s6 feat">
          <div><div class="k">{lead.kicker}</div><h3>{lead.title}</h3>
            <p>{lead.short}</p>
            <div class="tags">{lead.stack.map((t) => <i>{t}</i>)}</div></div>
          <div><div class="big" data-n="50" data-s="+">50+</div><small>Visualforce pages rebuilt</small>
            <div class="list"><div><i class="ico c1">⚡</i><u>Page framework</u><s>Visualforce</s><em>→</em><u>LWC + Aura</u></div><div><i class="ico c4">⇄</i><u>Case routing</u><s>Manual</s><em>→</em><u>Automated</u></div><div><i class="ico c3">◷</i><u>SLA tracking</u><s>Spreadsheets</s><em>→</em><u>In platform</u></div></div></div>
        </article>
        {rest.map((p, i) => (
          <article class={`tile ${spans[i] || 's3'}`}><div class="k">{p.kicker}</div><h3>{p.title}</h3><p>{p.short}</p><div class="tags">{p.stack.map((t) => <i>{t}</i>)}</div></article>
        ))}
      </div>
    </div></section>

    <section class="alt" id="solutions"><div class="wrap">
      <h2 class="h">Built on my own time. <span>Tools I wanted to exist.</span></h2>
      <div class="grid">
        <article class="tile s3 prod"><span class="tint t1"></span><i class="ico c2" aria-hidden="true">⌕</i><div class="k">{inspector.kicker}</div><h3>{inspector.title}</h3><p>{inspector.summary}</p><div class="aiuse"><b>Built with AI:</b> {inspector.ai}</div>
          <div class="mini"><div class="bar"><strong>Findings</strong></div><div class="row"><b>SOQL queries</b><div class="pb"><s style="width:38%"></s></div><span>38 / 100</span></div><div class="row"><b>CPU time</b><div class="pb o"><s style="width:79%"></s></div><span>79%</span></div><div class="row"><b>Query in loop</b><span>line 42</span><span class="st r">High</span></div></div></article>
        <article class="tile s3 prod"><span class="tint t2"></span><i class="ico c3" aria-hidden="true">◷</i><div class="k">{scheduler.kicker}</div><h3>{scheduler.title}</h3><p>{scheduler.summary}</p><div class="aiuse"><b>Built with AI:</b> {scheduler.ai}</div>
          <div class="mini"><div class="bar"><strong>Schedules</strong></div>
            <div class="row"><b>Nightly sync</b><span>0 0 2 * * ?</span><span class="stt">Active</span><span class="sw on" role="switch" aria-checked="true" tabindex="0"></span></div>
            <div class="row"><b>Weekly cleanup</b><span>0 0 6 ? * MON</span><span class="stt">Active</span><span class="sw on" role="switch" aria-checked="true" tabindex="0"></span></div>
            <div class="row"><b>Data checks</b><span>0 0 * * * ?</span><span class="stt">Paused</span><span class="sw" role="switch" aria-checked="false" tabindex="0"></span></div></div></article>
      </div>
    </div></section>

    <section class="ai" id="ai"><div class="wall" aria-hidden="true"></div><div class="wrap">
      <span class="eyebrow">AI-assisted engineering</span>
      <h2 class="h" style="margin-top:8px">AI writes faster. <span>I decide what ships.</span></h2>
      <p class="lede" style="margin:18px 0 0;text-align:left">I use AI coding agents as a force multiplier on the tools above: they draft, refactor and generate tests at speed, while I own the architecture, the platform limits and every line that reaches an org.</p>
      <div class="flow">
        {aiFlow.map((f) => <div><small>{f.step}</small><h4>{f.title}</h4><p>{f.text}</p><div class="who">{f.who.map((w) => <i class={w === 'ai' ? 'bot' : 'me'}>{w === 'ai' ? 'AI' : 'Me'}</i>)}</div></div>)}
      </div>
      <div class="grid">
        {aiCards.map((c) => (
          <div class="tile s3 aic"><i class={`ico ${c.c}`} style="width:46px;height:46px;font-size:20px;margin-bottom:18px" aria-hidden="true">{c.icon}</i><div class="k">{c.kicker}</div><h3>{c.title}</h3><p>{c.text}</p><ul>{c.points.map((p) => <li>{p}</li>)}</ul></div>
        ))}
      </div>
    </div></section>

    <section id="approach"><div class="wrap">
      <h2 class="h">How I build. <span>Every time.</span></h2>
      <div class="steps">
        {approach.map((a) => <div><i class={`ico ${a.c}`} aria-hidden="true">{a.icon}</i><h4>{a.title}</h4><p>{a.text}</p></div>)}
      </div>
      <div class="grid">
        {capabilities.map((c) => <div class="tile cap s2"><i class={`ico ${c.c}`} aria-hidden="true">{c.icon}</i><div><h4>{c.title}</h4><p>{c.text}</p></div></div>)}
      </div>
    </div></section>

    <section class="alt" id="experience"><div class="wrap">
      <h2 class="h">Experience. <span>Four years, two teams.</span></h2>
      {roles.map((r) => (
        <div class="role"><div><h3>{r.company}</h3><small>{r.title}</small><time>{r.when}</time></div><ul>{r.points.map((p) => <li>{p}</li>)}</ul></div>
      ))}
    </div></section>

    <section id="credentials"><div class="wrap">
      <h2 class="h">Certified. <span>And still learning.</span></h2>
      <div class="badges">
        {certifications.map((c) => <div class="badge"><img src={img(c.img)} alt="" loading="lazy" width="116" height="116" />{c.name}<small>Salesforce Certified</small></div>)}
      </div>
      <div class="sb">
        {superbadges.map((b) => <div><img src={img(b.img)} alt="" loading="lazy" width="44" height="44" /><span>{b.name}<small>{b.sub}</small></span></div>)}
      </div>
      <div class="edu">{education.map((e) => <div><b>{e.degree}</b>{e.school} · {e.when}</div>)}</div>
    </div></section>

    <section class="end alt" id="contact"><div class="wall" aria-hidden="true"></div><div class="wrap">
      <h2 class="h">Have a Salesforce problem worth solving?</h2>
      <p>Let's talk about it.</p>
      <div class="cta"><a class="btn" href={`mailto:${links.email}`}>Email me</a><a class="lnk" href={links.linkedin} rel="me noopener" target="_blank">LinkedIn ›</a><a class="lnk" href={links.trailhead} rel="me noopener" target="_blank">Trailhead ›</a><a class="lnk" href={links.github} rel="me noopener" target="_blank">GitHub ›</a></div>
    </div></section>
    </main>
    <footer><div class="wrap"><span>Copyright © 2026 {profile.name}. {profile.location}.</span><span><a href={`${base}Resume.pdf`}>Résumé</a> · <a href={links.linkedin}>LinkedIn</a> · <a href={links.trailhead}>Trailhead</a> · <a href={links.github}>GitHub</a></span></div></footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
